# Copy to .env and export what you need. Everything is optional: with nothing
# set, the console runs in demo mode against recorded fixtures with local
# file-backed state.

# --- Model access (unset = demo mode; no API key needed to try the pipeline) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_AUTH_TOKEN=            # alternative to the API key (e.g. `ant auth login`)

# --- Spend control ---
# Per-run ceiling in USD, enforced server-side; crossing it fails the run.
# ANDROMEDA_BUDGET_USD=5
# Ceiling on spend across ALL runs in a rolling 24h window. Once reached, new
# runs are refused and existing runs cannot add spend — but resuming to
# deliver an already-approved build still works. Unset = no org-level bound.
# ANDROMEDA_GLOBAL_BUDGET_USD=25

# --- State & delivery (local defaults shown) ---
# ANDROMEDA_STATE_DIR=./.andromeda/state   # FileStore location when Supabase is unset
# ANDROMEDA_OUT_DIR=./.andromeda/out       # where approved builds are delivered
# PORT=4200                                # console port

# --- Console access ---
# When set, every console route (pages, form posts and the JSON API) demands
# HTTP Basic auth with this password. Unset = open; localhost only.
# ANDROMEDA_CONSOLE_PASSWORD=

# --- GitHub delivery (unset = approved builds are written to ANDROMEDA_OUT_DIR) ---
# With both set, an approved build becomes a draft pull request in this repo:
# a new branch on top of the base, never a force-push. The token needs
# contents:write and pull-requests:write on the target repository.
# ANDROMEDA_DELIVERY_REPO=owner/repo
# GITHUB_TOKEN=
# ANDROMEDA_DELIVERY_BASE=                 # PR base branch; default: the repo's default branch

# --- Durable store (unset = local FileStore/MemoryStore) ---
# Apply supabase/migrations/0001_andromeda_store.sql to the project first.
# The service-role key bypasses row-level security: server-side only, never
# in a browser or a scaffolded project's env.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=               # fallback; subject to the table's RLS policy
# SUPABASE_PUBLISHABLE_KEY=        # fallback; same as anon
